{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wishlist",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-29",

  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wishlist-db",
      "database_id": "f1566f87-6602-4f5a-b1f0-d61cf4892958",
      "migrations_dir": "migrations"
    }
  ]
}
